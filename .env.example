# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Твой Telegram ID (узнать можно у @userinfobot). Можно несколько через пробел/запятую.
ADMIN_IDS=123456789

# Каналы/чаты, подписку на которые проверяем.
# Можно @username (для публичных) или числовой id вида -100xxxxxxxxxx (для приватных).
# Несколько — через пробел или запятую. Бот должен быть АДМИНОМ в каждом.
REQUIRED_CHATS=@my_channel @my_chat

# Путь к файлу базы (необязательно)
DB_PATH=bot.db

# --- ИИ-ведущий для игр (Бункер) ---
# Ключ Anthropic API (console.anthropic.com → API Keys). Без него игра работает
# на встроенном генераторе (без «умных» комментариев ИИ).
ANTHROPIC_API_KEY=sk-ant-...
# Модель ИИ. По умолчанию claude-opus-5-5 (умнее, дороже).
# Для экономии можно claude-haiku-5-5 (дешевле в десятки раз) или claude-sonnet-5-5.
AI_MODEL=claude-opus-5-5
# Дешёвая модель для коротких реплик ведущего (в ~40 раз дешевле Opus).
AI_MODEL_FAST=claude-haiku-5-5
# «Редактор» стёб-бота: проверяет смысл коротких реплик перед отправкой.
AI_MODEL_EDIT=claude-sonnet-5-5

# Каналы бати, посты которых стёб-бот комментирует в чате (через запятую).
# Автопересылка из канала, привязанного к чату, считается постом бати всегда.
BOT_CHANNEL_NAMES=Memento Mori
# Кто пишет ответы людям в чате (по умолчанию — та же модель, что редактор).
# AI_MODEL_REPLY=claude-sonnet-5-5
# Посты бота в канал: модели через запятую (каждый пост — случайная) и глубина размышления.
# По умолчанию Opus 5.5 и Gemini 4 Argon (Gemini — нужен OPENROUTER_API_KEY).
# AI_MODEL_POSTS=claude-opus-5-5,google/gemini-4-argon
# AI_POSTS_EFFORT=high
# Сторонние модели (GPT, Grok, Gemini, Kimi…) через OpenRouter — для постов и /compare.
# Ключ: openrouter.ai → Keys. Модель поста можно задать так: AI_MODEL_POSTS=x-ai/grok-4.7
# OPENROUTER_API_KEY=sk-or-...
# Кого сравнивать в /compare (через запятую):
# COMPARE_MODELS=claude-opus-5-5,claude-fable-5-1,openai/gpt-6.1-terra-pro,x-ai/grok-4.7,google/gemini-4-argon,moonshotai/kimi-k3.1-pro
